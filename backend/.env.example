# Flask session secret (use a long random value outside development)
SECRET_KEY=

# Render supplies this value when a PostgreSQL database is linked.
# Leave it unset to use backend/instance/chicken_business.db locally.
DATABASE_URL=

# Exact React origin allowed to call /api routes with session cookies.
FRONTEND_URL=http://localhost:5173

# Set to 1 on Render/HTTPS deployments. Leave unset for local HTTP development.
FLASK_HTTPS=

# Optional first administrator. All four values are required together.
INITIAL_ADMIN_NAME=
INITIAL_ADMIN_USERNAME=
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=

# Daraja sandbox configuration. Production is intentionally not enabled yet.
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=https://your-public-https-domain.example/api/payments/mpesa/callback
